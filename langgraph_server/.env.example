TAVILY_API_KEY=...

# To separate your traces from other application
LANGSMITH_PROJECT=react-agent

# The following depend on your selected configuration

## LLM choice:
ANTHROPIC_API_KEY=....
FIREWORKS_API_KEY=...

## Azure OpenAI (provider: azure_openai)
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# API version sent as the api-version query param (defaults to 2025-04-01-preview if unset)
OPENAI_API_VERSION=2025-04-01-preview
# Azure deployment name to route to (defaults to the configured model name if unset)
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

## Supabase (REQUIRED for resume_ranker — it downloads resume PDFs from a storage bucket)
# Must match the project + bucket the .NET backend uploads resumes to.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key
BUCKET_NAME=resume-storage
