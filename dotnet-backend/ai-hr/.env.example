# ================================
# AI-HR Platform Environment Variables
# ================================

# ✅ JWT Configuration - CRITICAL: Generate a strong secret key
JWT_SECRET_KEY=your-super-strong-jwt-secret-key-should-be-at-least-256-bits

# ✅ Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# ✅ CORS Configuration - CRITICAL: Restrict to your domain in production
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ✅ Google API Configuration (for Gmail and Calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ✅ Application URLs
ASPNETCORE_URLS=http://localhost:5189

# ================================
# Security Configuration Notes
# ================================

# JWT Secret Key Generation:
# - PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes(32))
# - OpenSSL: openssl rand -base64 32
# - Node.js: require('crypto').randomBytes(32).toString('base64')
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit actual secrets to version control
# 2. Use different secrets for development and production
# 3. Rotate JWT secrets regularly in production
# 4. Restrict ALLOWED_ORIGINS to specific domains in production
# 5. Use HTTPS in production (update ASPNETCORE_URLS accordingly)

# ================================
# Development vs Production
# ================================

# Development:
# JWT_SECRET_KEY=dev-only-secret-key-not-for-production
# ALLOWED_ORIGINS=http://localhost:3000
# ASPNETCORE_URLS=http://localhost:5189

# Production:
# JWT_SECRET_KEY=your-production-secret-256-bits-minimum
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# ASPNETCORE_URLS=https://yourdomain.com