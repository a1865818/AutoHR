# ================================
# AI-HR Platform Environment Variables
# ================================

# ✅ SUPABASE JWT SIGNING KEYS CONFIGURATION
# Updated to support Supabase's new asymmetric JWT authentication system

# Supabase Project Configuration
SUPABASE_URL=your-supabase-url

# NEW: JWT Signing Keys (recommended for new projects)
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# LEGACY: JWT Secret (for backward compatibility until migration)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Legacy JWT Configuration (deprecated - will be removed)
JWT_SECRET_KEY=your-super-strong-jwt-secret-key-should-be-at-least-256-bits

# ✅ CORS Configuration - CRITICAL: Restrict to your domain in production
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ✅ Google API Configuration (for Gmail and Calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ✅ Application URLs
ASPNETCORE_URLS=http://localhost:5189

# ✅ LangGraph AI Server (required for all AI features: JD generation, resume_ranker
#    candidate ranking, business-context analysis, criteria discovery, cultural fit)
# The base URL of the LangGraph Platform server (langgraph dev defaults to port 2024).
LANGGRAPH_URL=http://127.0.0.1:2024
# Optional: override the assistant id used for a specific graph. By default the .NET
# backend passes the graph name directly as the assistant_id (the Platform resolves it
# to that graph's default assistant), so these only need setting for non-default assistants.
# LANGGRAPH_RESUME_RANKER_ASSISTANT_ID=resume_ranker
# LANGGRAPH_JOB_DESCRIPTION_GENERATOR_ASSISTANT_ID=job_description_generator

# ✅ Supabase Storage bucket holding candidate resumes (read by resume_ranker).
BUCKET_NAME=resume-storage

# ================================
# Security Configuration Notes
# ================================

# JWT Secret Key Generation:
# - PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes(32))
# - OpenSSL: openssl rand -base64 32
# - Node.js: require('crypto').randomBytes(32).toString('base64')
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit actual secrets to version control
# 2. Use different secrets for development and production
# 3. Rotate JWT secrets regularly in production
# 4. Restrict ALLOWED_ORIGINS to specific domains in production
# 5. Use HTTPS in production (update ASPNETCORE_URLS accordingly)

# ================================
# Development vs Production
# ================================

# Development:
# JWT_SECRET_KEY=dev-only-secret-key-not-for-production
# ALLOWED_ORIGINS=http://localhost:3000
# ASPNETCORE_URLS=http://localhost:5189

# Production:
# JWT_SECRET_KEY=your-production-secret-256-bits-minimum
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# ASPNETCORE_URLS=https://yourdomain.com